rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isProfileOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidXp() {
      return request.resource.data.keys().hasAll(['xp']) &&
        request.resource.data.xp is int;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrivateAccount(userId) {
      return exists(
        /databases/$(database)/documents/public_profiles/$(userId)
      )
      && get(
        /databases/$(database)/documents/public_profiles/$(userId)
      ).data.keys().hasAny(['isPrivateAccount'])
      && get(
        /databases/$(database)/documents/public_profiles/$(userId)
      ).data.isPrivateAccount == true;
    }

    function isApprovedFollower(userId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId)
      );
    }

    function canViewProfileActivity(userId) {
      return isProfileOwner(userId) ||
        (isSignedIn() && (!isPrivateAccount(userId) || isApprovedFollower(userId)));
    }

    function isPairParticipant(data) {
      return isSignedIn() &&
        (request.auth.uid == data.senderId || request.auth.uid == data.recipientId);
    }

    function sortedPairKey(userA, userB) {
      return userA < userB ? userA + '_' + userB : userB + '_' + userA;
    }

    function hasPublicProfileFields() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'username',
        'usernameSearch',
        'displayName',
        'displayNameSearch',
        'photoUrl',
        'xp',
        'level',
        'isPrivateAccount',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid is string &&
      request.resource.data.username is string &&
      request.resource.data.usernameSearch is string &&
      request.resource.data.displayName is string &&
      request.resource.data.displayNameSearch is string &&
      request.resource.data.createdAt is string &&
      request.resource.data.updatedAt is string &&
      (!request.resource.data.keys().hasAny(['xp']) ||
        request.resource.data.xp is int) &&
      (!request.resource.data.keys().hasAny(['level']) ||
        request.resource.data.level is int) &&
      (!request.resource.data.keys().hasAny(['isPrivateAccount']) ||
        request.resource.data.isPrivateAccount is bool);
    }

    function hasFriendRequestFields() {
      return request.resource.data.keys().hasOnly([
        'pairKey',
        'senderId',
        'recipientId',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.pairKey is string &&
      request.resource.data.senderId is string &&
      request.resource.data.recipientId is string &&
      request.resource.data.status is string &&
      request.resource.data.createdAt is string &&
      request.resource.data.updatedAt is string;
    }

    function hasFollowFields() {
      return request.resource.data.keys().hasOnly([
        'followerId',
        'followeeId',
        'createdAt',
        'source',
        'acceptedRequestId',
        'acceptedRequestCreatedAt'
      ]) &&
      request.resource.data.followerId is string &&
      request.resource.data.followeeId is string &&
      request.resource.data.createdAt is string &&
      (!request.resource.data.keys().hasAny(['source']) ||
        request.resource.data.source is string) &&
      (!request.resource.data.keys().hasAny(['acceptedRequestId']) ||
        request.resource.data.acceptedRequestId is string) &&
      (!request.resource.data.keys().hasAny(['acceptedRequestCreatedAt']) ||
        request.resource.data.acceptedRequestCreatedAt is string);
    }

    function hasFollowRequestFields() {
      return request.resource.data.keys().hasOnly([
        'requesterId',
        'targetId',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.requesterId is string &&
      request.resource.data.targetId is string &&
      request.resource.data.status is string &&
      request.resource.data.createdAt is string &&
      request.resource.data.updatedAt is string;
    }

    function isImmediatePublicFollow(followId) {
      return request.auth.uid == request.resource.data.followerId
        && !isPrivateAccount(request.resource.data.followeeId)
        && !request.resource.data.keys().hasAny(['source', 'acceptedRequestId'])
        && followId == request.resource.data.followerId + '_' +
          request.resource.data.followeeId;
    }

    function isAcceptedRequestFollow(followId) {
      return request.auth.uid == request.resource.data.followeeId
        && request.resource.data.source == 'follow_request_acceptance'
        && request.resource.data.acceptedRequestId == followId
        && followId == request.resource.data.followerId + '_' +
          request.resource.data.followeeId
        && exists(
          /databases/$(database)/documents/follow_requests/$(followId)
        )
        && get(
          /databases/$(database)/documents/follow_requests/$(followId)
        ).data.requesterId == request.resource.data.followerId
        && get(
          /databases/$(database)/documents/follow_requests/$(followId)
        ).data.targetId == request.resource.data.followeeId
        && get(
          /databases/$(database)/documents/follow_requests/$(followId)
        ).data.status == 'pending'
        && request.resource.data.acceptedRequestCreatedAt == get(
          /databases/$(database)/documents/follow_requests/$(followId)
        ).data.createdAt;
    }

    function followNotificationId(data, userId) {
      return 'follow_' + data.actorId + '_' + userId;
    }

    function requestNotificationId(data, userId) {
      return 'follow_request_' + data.actorId + '_' + userId;
    }

    function acceptedNotificationId(data, userId) {
      return 'follow_request_accepted_' + data.actorId + '_' + userId;
    }

    function hasNotificationFields(data, userId) {
      return data.keys().hasOnly([
          'recipientId',
          'actorId',
          'type',
          'createdAt',
          'readAt'
        ])
        && data.recipientId == userId
        && data.actorId is string
        && data.actorId != userId
        && data.type in [
          'follow',
          'followRequest',
          'followRequestAccepted'
        ]
        && data.createdAt is string
        && (data.readAt == null || data.readAt is string);
    }

    function isValidFollowNotificationWrite(notificationId, data, userId) {
      return data.type == 'follow'
        && notificationId == followNotificationId(data, userId)
        && exists(
          /databases/$(database)/documents/follows/$(data.actorId + '_' + userId)
        )
        && get(
          /databases/$(database)/documents/follows/$(data.actorId + '_' + userId)
        ).data.createdAt == data.createdAt
        && (
          (
            request.auth.uid == data.actorId
            && !get(
              /databases/$(database)/documents/follows/$(data.actorId + '_' + userId)
            ).data.keys().hasAny(['source'])
          ) ||
          (
            request.auth.uid == userId
            && get(
              /databases/$(database)/documents/follows/$(data.actorId + '_' + userId)
            ).data.source == 'follow_request_acceptance'
          )
        );
    }

    function isValidRequestNotificationWrite(notificationId, data, userId) {
      return data.type == 'followRequest'
        && notificationId == requestNotificationId(data, userId)
        && request.auth.uid == data.actorId
        && exists(
          /databases/$(database)/documents/follow_requests/$(data.actorId + '_' + userId)
        )
        && get(
          /databases/$(database)/documents/follow_requests/$(data.actorId + '_' + userId)
        ).data.createdAt == data.createdAt;
    }

    function isValidAcceptedNotificationWrite(notificationId, data, userId) {
      return data.type == 'followRequestAccepted'
        && notificationId == acceptedNotificationId(data, userId)
        && request.auth.uid == data.actorId
        && exists(
          /databases/$(database)/documents/follows/$(userId + '_' + data.actorId)
        )
        && get(
          /databases/$(database)/documents/follows/$(userId + '_' + data.actorId)
        ).data.source == 'follow_request_acceptance';
    }

    function isValidNotificationWrite(notificationId, data, userId) {
      return hasNotificationFields(data, userId)
        && (
          isValidFollowNotificationWrite(notificationId, data, userId)
          || isValidRequestNotificationWrite(notificationId, data, userId)
          || isValidAcceptedNotificationWrite(notificationId, data, userId)
        );
    }

    function canDeleteCurrentRelationshipNotification(notificationId, userId) {
      return (
          resource.data.type == 'follow'
          && notificationId == followNotificationId(resource.data, userId)
          && (
            request.auth.uid == resource.data.actorId
            || request.auth.uid == userId
          )
        ) ||
        (
          resource.data.type == 'followRequest'
          && notificationId == requestNotificationId(resource.data, userId)
          && (
            request.auth.uid == resource.data.actorId
            || request.auth.uid == userId
          )
        );
    }

    match /profiles/{userId} {
      // Only the signed-in owner can read/write their own profile document.
      allow read: if isProfileOwner(userId);
      allow create, update: if isProfileOwner(userId) && hasValidXp();
      allow delete: if false;
      
      // Visits subcollection - tracks places the user has visited
      match /visits/{visitId} {
        allow read: if canViewProfileActivity(userId);
        allow create, update: if request.auth != null && request.auth.uid == userId;
        // No deletes - visits are permanent
        allow delete: if false;
      }
      
      // Journeys subcollection - tracks user's journey history
      match /journeys/{journeyId} {
        // Only the signed-in owner can read/create/update their own journeys.
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        // Allow deleting journeys
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Timestamped XP gain events for weekly XP Gained analytics.
      match /xp_events/{eventId} {
        allow read: if canViewProfileActivity(userId);
        allow create: if isProfileOwner(userId);
        allow update, delete: if false;
      }

      // Persistent social inbox (follow notifications). Prefer Cloud Function
      // creation; clients may create only as the actor for a real follow doc.
      match /notifications/{notificationId} {
        allow read: if isProfileOwner(userId);
        allow create: if isSignedIn()
          && isValidNotificationWrite(
            notificationId,
            request.resource.data,
            userId
          );
        allow update: if isProfileOwner(userId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readAt'])
              && request.resource.data.recipientId == resource.data.recipientId
              && request.resource.data.actorId == resource.data.actorId
              && request.resource.data.type == resource.data.type
              && request.resource.data.createdAt == resource.data.createdAt
              && (
                request.resource.data.readAt == null
                || request.resource.data.readAt is string
              )
            ) ||
            (
              isValidNotificationWrite(
                notificationId,
                request.resource.data,
                userId
              )
            )
          );
        allow delete: if isSignedIn()
          && canDeleteCurrentRelationshipNotification(notificationId, userId);
      }
    }

    // Find People prefix queries require signed-in list/read on this
    // collection. Keep production in sync:
    // firebase deploy --only firestore:rules --project roam-io-71e2c
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isProfileOwner(userId)
        && request.resource.data.uid == userId
        && hasPublicProfileFields();
      allow delete: if false;
    }

    match /friend_requests/{requestId} {
      allow read: if isPairParticipant(resource.data);
      allow create: if isSignedIn()
        && hasFriendRequestFields()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.recipientId
        && !exists(
          /databases/$(database)/documents/friendships/$(requestId)
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.pairKey ==
          sortedPairKey(
            request.resource.data.senderId,
            request.resource.data.recipientId
          )
        && requestId == request.resource.data.pairKey;
      allow update: if isSignedIn()
        && hasFriendRequestFields()
        && request.resource.data.pairKey == resource.data.pairKey
        && (
          (
            resource.data.status == 'pending'
            && request.auth.uid == resource.data.recipientId
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.recipientId == resource.data.recipientId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status in ['accepted', 'declined']
          ) ||
          (
            resource.data.status == 'declined'
            && request.auth.uid == request.resource.data.senderId
            && request.resource.data.senderId != request.resource.data.recipientId
            && request.resource.data.status == 'pending'
            && request.resource.data.pairKey ==
              sortedPairKey(
                request.resource.data.senderId,
                request.resource.data.recipientId
              )
            && requestId == request.resource.data.pairKey
            && !exists(
              /databases/$(database)/documents/friendships/$(requestId)
            )
          )
        );
      allow delete: if false;
    }

    match /friendships/{pairKey} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'pairKey',
          'memberIds',
          'createdAt',
          'acceptedRequestId'
        ])
        && request.resource.data.pairKey == pairKey
        && request.resource.data.acceptedRequestId == pairKey
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && getAfter(
          /databases/$(database)/documents/friend_requests/$(pairKey)
        ).data.status == 'accepted'
        && getAfter(
          /databases/$(database)/documents/friend_requests/$(pairKey)
        ).data.senderId in request.resource.data.memberIds
        && getAfter(
          /databases/$(database)/documents/friend_requests/$(pairKey)
        ).data.recipientId in request.resource.data.memberIds;
      allow update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasFollowFields()
        && request.resource.data.followerId != request.resource.data.followeeId
        && (
          isImmediatePublicFollow(followId) ||
          isAcceptedRequestFollow(followId)
        );
      // Follower may unfollow; followee may Remove follower.
      allow delete: if isSignedIn()
        && followId == resource.data.followerId + '_' + resource.data.followeeId
        && (
          resource.data.followerId == request.auth.uid
          || resource.data.followeeId == request.auth.uid
        );
      allow update: if false;
    }

    match /follow_requests/{requestId} {
      allow get: if isSignedIn()
        && (
          !exists(
            /databases/$(database)/documents/follow_requests/$(requestId)
          )
          || request.auth.uid == resource.data.requesterId
          || request.auth.uid == resource.data.targetId
        );
      allow list: if isSignedIn()
        && (
          request.auth.uid == resource.data.requesterId
          || request.auth.uid == resource.data.targetId
        );
      allow create: if isSignedIn()
        && hasFollowRequestFields()
        && request.auth.uid == request.resource.data.requesterId
        && request.resource.data.requesterId != request.resource.data.targetId
        && request.resource.data.status == 'pending'
        && requestId == request.resource.data.requesterId + '_' +
          request.resource.data.targetId
        && isPrivateAccount(request.resource.data.targetId)
        && !exists(
          /databases/$(database)/documents/follows/$(requestId)
        );
      allow delete: if isSignedIn()
        && resource.data.status == 'pending'
        && requestId == resource.data.requesterId + '_' + resource.data.targetId
        && (
          request.auth.uid == resource.data.requesterId
          || request.auth.uid == resource.data.targetId
        );
      allow update: if false;
    }

    match /polygons_visited/{userId} {
      allow get, list: if canViewProfileActivity(userId);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.profile_id == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.profile_id == request.auth.uid
        && request.resource.data.profile_id == request.auth.uid;
      allow delete: if false;
    }
    
    // User visits subcollection - tracks places the user has visited
    match /users/{userId}/visits/{visitId} {
      // Only the signed-in owner can read/create/update their own visits.
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      // No deletes - visits are permanent
      allow delete: if false;
    }

    // Deny all other collections/documents by default for MVP safety.
    // Activity comments (notifications for comments deferred).
    match /activities/{activityId} {
      allow read: if request.auth != null
        && resource.data.profileId is string
        && canViewProfileActivity(resource.data.profileId);
      allow write: if false;

      match /comments/{commentId} {
        allow read: if request.auth != null
          && get(
            /databases/$(database)/documents/activities/$(activityId)
          ).data.profileId is string
          && canViewProfileActivity(
            get(
              /databases/$(database)/documents/activities/$(activityId)
            ).data.profileId
          );
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.keys().hasAll([
            'authorId',
            'authorDisplayName',
            'text',
            'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
