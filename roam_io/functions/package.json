{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill:public-profiles": "node scripts/backfill_public_profiles.js --project roam-io-71e2c",
    "inspect:public-profiles": "node scripts/inspect_public_profiles.js --project roam-io-71e2c --username jacob_delapaz",
    "seed:test-activity": "node scripts/seed_test_activity.js --project roam-io-71e2c",
    "verify:test-activity": "node scripts/verify_test_activity.js --project roam-io-71e2c",
    "cleanup:stub-activities": "node scripts/cleanup_stub_activities.js --project roam-io-71e2c --dry-run",
    "test:backfill": "node scripts/backfill_public_profiles.test.js",
    "test:seed-activity": "node scripts/seed_test_activity.test.js && node scripts/cleanup_stub_activities.test.js",
